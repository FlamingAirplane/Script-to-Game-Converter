{
  "name": "narrative-bridge",
  "version": "0.4.0",
  "description": "Convert screenplays and prose into Ink stories and package them for Unity or Unreal Engine.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "cli": "tsx src/cli/index.ts",
    "build:single": "tsc --noEmit && vite build --mode single && node scripts/package-single.mjs",
    "test:e2e": "npm run build:single && node tests/e2e/writer-file.mjs",
    "test:a11y": "npm run build:single && node tests/e2e/a11y.mjs",
    "test:overflow": "npm run build:single && node tests/e2e/overflow.mjs",
    "test:offline": "npm run build && node tests/e2e/offline.mjs",
    "test:admin": "node tests/e2e/admin.mjs",
    "icons": "node scripts/icons.mjs",
    "guide:screenshots": "npm run build:single && node scripts/guide-screenshots.mjs",
    "design:publish": "tsx scripts/design-publish.ts",
    "test:unity": "tsx scripts/unity-check.ts",
    "test:unreal": "tsx scripts/unreal-check.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FlamingAirplane/Script-to-Game-Converter.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "type": "module",
  "bugs": {
    "url": "https://github.com/FlamingAirplane/Script-to-Game-Converter/issues"
  },
  "homepage": "https://github.com/FlamingAirplane/Script-to-Game-Converter#readme",
  "dependencies": {
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/im-fell-english-sc": "^5.3.0",
    "inkjs": "^2.4.0",
    "jszip": "^3.10.2",
    "pdfjs-dist": "6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "axe-core": "^4.14.0",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^6.4.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^4.1.12"
  },
  "private": true,
  "bin": {
    "narrative-bridge": "src/cli/index.ts"
  }
}
