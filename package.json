{
  "name": "narrative-bridge",
  "version": "0.5.0",
  "description": "Turn a script into a playable story, then hand it to a game developer. Screenplays and prose become Ink stories packaged for Unity or Unreal Engine.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "eval:adapt": "tsx scripts/adapt-eval.ts",
    "typecheck": "tsc --noEmit",
    "cli": "tsx src/cli/index.ts",
    "build:single": "tsc --noEmit && vite build --mode single && node scripts/package-single.mjs",
    "test:e2e": "npm run build:single && node tests/e2e/writer-file.mjs",
    "test:a11y": "npm run build:single && node tests/e2e/a11y.mjs",
    "test:overflow": "npm run build:single && node tests/e2e/overflow.mjs",
    "test:conformance:playable": "tsx tests/e2e/conformance-playable.ts",
    "test:offline": "npm run build && node tests/e2e/offline.mjs",
    "test:admin": "node tests/e2e/admin.mjs",
    "icons": "node scripts/icons.mjs",
    "guide:screenshots": "npm run build:single && node scripts/guide-screenshots.mjs",
    "design:publish": "tsx scripts/design-publish.ts",
    "test:unity": "tsx scripts/unity-check.ts",
    "test:unreal": "tsx scripts/unreal-check.ts",
    "test:unreal:build": "tsx scripts/unreal-build.ts",
    "build:unreal-plugin": "tsx scripts/unreal-plugin-build.ts",
    "templates": "node scripts/templates.mjs",
    "reader-core": "node scripts/reader-core.mjs",
    "lint": "oxlint --deny-warnings src tests scripts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FlamingAirplane/Script-to-Game-Converter.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "type": "module",
  "bugs": {
    "url": "https://github.com/FlamingAirplane/Script-to-Game-Converter/issues"
  },
  "homepage": "https://github.com/FlamingAirplane/Script-to-Game-Converter#readme",
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/im-fell-english-sc": "^5.3.0",
    "@huggingface/transformers": "^4.3.2",
    "@huggingface/transformers-structured-output": "^4.3.2",
    "inkjs": "^2.4.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.73.0",
    "pdfjs-dist": "6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "axe-core": "^4.14.0",
    "oxlint": "^1.93.0",
    "playwright-core": "^1.65.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  },
  "private": true,
  "bin": {
    "pen-to-ink": "src/cli/index.ts",
    "narrative-bridge": "src/cli/index.ts"
  }
}
