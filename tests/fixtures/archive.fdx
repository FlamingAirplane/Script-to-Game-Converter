<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<FinalDraft DocumentType="Script" Template="No" Version="5">
  <Content>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="1" Page="1" Title=""/>
      <Text>INT. ARCHIVE - NIGHT</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Rows of shelves vanish into the dark. </Text><Text Style="Bold">MIRA</Text><Text> lifts a lantern &amp; squints.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MIRA</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(whispering)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>The archive is locked. &#8220;Again.&#8221;</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>THE DOOR CREAKS.</Text>
    </Paragraph>
    <DualDialogue>
      <Paragraph Type="Character"><Text>TOMAS (O.S.)</Text></Paragraph>
      <Paragraph Type="Dialogue"><Text>Who's there?</Text></Paragraph>
      <Paragraph Type="Character"><Text>MIRA</Text></Paragraph>
      <Paragraph Type="Dialogue"><Text>Only me.</Text></Paragraph>
    </DualDialogue>
    <Paragraph Type="Transition">
      <Text>CUT TO:</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <Text>EXT. CLIFF PATH - DAWN</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>She walks into the light.</Text>
    </Paragraph>
    <Paragraph Type="Action"/>
  </Content>
  <TitlePage>
    <Content>
      <Paragraph Type="Action"><Text>The Locked Archive</Text></Paragraph>
      <Paragraph Type="Action"><Text>Written by</Text></Paragraph>
      <Paragraph Type="Action"><Text>A. Writer</Text></Paragraph>
    </Content>
  </TitlePage>
</FinalDraft>
