{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "react", "oxc"],
  "categories": { "correctness": "error" },
  "env": { "browser": true, "node": true, "es2024": true },
  "ignorePatterns": ["dist/**", "release/**", "node_modules/**", "tests/unreal-stubs/**", "src/core/export/templates.generated.ts"],
  "rules": {
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "warn",
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_", "destructuredArrayIgnorePattern": "^_", "ignoreRestSiblings": true, "caughtErrors": "none" }],
    "no-unused-expressions": "off",
    "no-control-regex": "off",
    "unicorn/no-thenable": "off",
    "react/set-state-in-effect": "off",
    "react/refs": "off",
    "react/immutability": "off"
  }
}
